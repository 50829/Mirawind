# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# Decap CMS
PUBLIC_DECAP_CMS_SRC_URL=https://unpkg.com/decap-cms@^3.3.3/dist/decap-cms.js
PUBLIC_DECAP_CMS_VERSION=3.3.3

# Umami Analytics
# API Key - 用于获取统计数据（从 Umami 设置中获取）
UMAMI_API_KEY=your_umami_api_key

# Tracking Code - 页面追踪脚本（替换 data-website-id 为你的 Website ID）
UMAMI_TRACKING_CODE=<script defer src="https://cloud.umami.is/script.js" data-website-id="your_website_id"></script>
