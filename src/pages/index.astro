---
import { getEntry, render } from "astro:content";
import GridLayout from "@layouts/grid.astro";
import Markdown from "@components/common/markdown.astro";
import { url } from "@utils/url";
import { PAGE_SIZE } from "@constants/constants";
import { getSortedPosts } from "@utils/content";
import Pagination from "@components/pagination.astro";
import PostPage from "@components/postPage.astro";

const homePost = await getEntry("spec", "home");
if (!homePost) {
    throw new Error("Home page content not found");
}

const { Content } = await render(homePost);

// 手动获取第一页的博客文章
const allPosts = await getSortedPosts();
const firstPagePosts = allPosts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

// 创建类似分页对象的结构
const page = {
    data: firstPagePosts,
    start: 0,
    end: firstPagePosts.length - 1,
    size: PAGE_SIZE,
    total: allPosts.length,
    currentPage: 1,
    lastPage: totalPages,
    url: {
        current: "/",
        prev: undefined,
        next: totalPages > 1 ? "/blog/2/" : undefined,
    },
};

const len = page.data.length;
---

<GridLayout title="Home" headings={[]}>
    <!-- 欢迎内容区域 -->
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32 mb-4">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- 页面内容 -->
            <Markdown class="mt-2">
                <Content />
            </Markdown>

            <!-- 快速导航 -->
            <div class="flex flex-wrap gap-4 mb-8 mt-8">
                <a href={url('/blog/')} class="px-6 py-3 bg-[var(--primary)] text-white rounded-lg hover:opacity-80 transition">
                    📚 Blogs
                </a>
                <a href={url('/about/')} class="px-6 py-3 bg-[var(--btn-regular-bg)] text-black/80 dark:text-white/80 rounded-lg hover:bg-[var(--btn-regular-bg-hover)] transition">
                    ➡️ More about me
                </a>
            </div>
        </div>
    </div>

    <!-- 博客文章列表 -->
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: ${(len)*50}ms`}></Pagination>

</GridLayout>
