---
import I18nKey from "@i18n/i18nKey";

import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";

interface Props {
	id: string;
	name?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
	[key: string]: unknown;
}
const {
	id,
	name,
	isCollapsed,
	collapsedHeight,
	style,
	class: className,
	...restProps
} = Astro.props;
---

<widget-layout data-id={id} data-is-collapsed={String(isCollapsed)} class={"pb-4 card-base " + className} style={style}>
    <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2
        before:w-1 before:h-4 before:rounded-md before:bg-(--primary)
        before:absolute before:left-[-16px] before:top-[5.5px]">{name}</div>
    <div id={id} class:list={["collapse-wrapper px-4 overflow-hidden", {"collapsed": isCollapsed}]} {...restProps}>
        <slot></slot>
    </div>
    {isCollapsed && <div class="expand-btn px-4 -mb-2">
        <button class="btn-plain rounded-lg w-full h-9" aria-expanded="false">
            <div class="text-(--primary) flex items-center justify-center gap-2 -translate-x-2">
                <Icon name="material-symbols:more-horiz" class="expand-icon-more text-[1.75rem]"></Icon>
                <Icon name="material-symbols:expand-less" class="expand-icon-less hidden text-[1.75rem]"></Icon>
                <span class="expand-label" data-more={i18n(I18nKey.more)} data-less={i18n(I18nKey.less)}>
                    {i18n(I18nKey.more)}
                </span>
            </div>
        </button>
    </div>}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
	.collapse-wrapper {
		transition: height 300ms cubic-bezier(0.4, 0, 0.2, 1);
	}

    .collapsed {
        height: var(--collapsedHeight);
    }

    @media (prefers-reduced-motion: reduce) {
        .collapse-wrapper {
            transition: none;
        }
    }
</style>

<script>
    class WidgetLayout extends HTMLElement {
        constructor() {
            super();

			if (this.dataset.isCollapsed !== "true")
				return;

			this.dataset.expanded = "false";

			const id = this.dataset.id;
			const btn = this.querySelector<HTMLButtonElement>(".expand-btn button");
			const wrapper = this.querySelector<HTMLElement>(`#${id}`);
			const label = this.querySelector<HTMLElement>(".expand-label");
			const moreIcon = this.querySelector<HTMLElement>(".expand-icon-more");
			const lessIcon = this.querySelector<HTMLElement>(".expand-icon-less");

			const syncButton = (isExpanded: boolean) => {
				this.dataset.expanded = String(isExpanded);
				btn!.setAttribute("aria-expanded", String(isExpanded));
				label!.textContent = isExpanded
					? label!.dataset.less!
					: label!.dataset.more!;
				moreIcon!.classList.toggle("hidden", isExpanded);
				lessIcon!.classList.toggle("hidden", !isExpanded);
			};

			const setExpanded = (isExpanded: boolean) => {
				const currentHeight = wrapper!.getBoundingClientRect().height;
				wrapper!.style.height = `${currentHeight}px`;

				if (isExpanded) {
					syncButton(true);
					wrapper!.classList.remove("collapsed");

					requestAnimationFrame(() => {
						wrapper!.style.height = `${wrapper!.scrollHeight}px`;
					});

					wrapper!.addEventListener(
						"transitionend",
						() => {
							wrapper!.style.height = "";
						},
						{ once: true },
					);

					return;
				}

				syncButton(false);

				requestAnimationFrame(() => {
					wrapper!.classList.add("collapsed");
					wrapper!.style.height = "";
				});
			};

            btn!.addEventListener('click', () => {
				setExpanded(wrapper!.classList.contains("collapsed"));
            })
        }
    }

    if (!customElements.get("widget-layout")) {
        customElements.define("widget-layout", WidgetLayout);
    }
</script>
