---
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getCategoryList, getSortedPosts, getTagList } from "@utils/content";
import WidgetLayout from "./widgetLayout.astro";

interface Props {
    class?: string;
    style?: string;
}

const { class: className, style } = Astro.props;

const siteStartDate = siteConfig.siteStartDate || "2025-12-24";

// 获取所有文章、分类和标签
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
    try {
        const { remarkPluginFrontmatter } = await render(post);
        if (remarkPluginFrontmatter?.words) {
            totalWords += remarkPluginFrontmatter.words;
        }
    } catch {
        // 备用方法：手动估算字数
        if (post.body) {
            const text = post.body.replace(/```[\s\S]*?```/g, "").replace(/`[^`]+`/g, "");
            const cjkPattern = /[\u4e00-\u9fa5\u3040-\u309f\u30a0-\u30ff\uac00-\ud7af]/g;
            const cjkMatches = text.match(cjkPattern);
            const cjkCount = cjkMatches ? cjkMatches.length : 0;
            const nonCjkText = text.replace(cjkPattern, " ");
            const nonCjkWords = nonCjkText.split(/\s+/).filter((w) => w.trim().length > 0);
            totalWords += cjkCount + nonCjkWords.length;
        }
    }
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
    return num.toLocaleString();
}

// 计算天数差（毫秒转天数）
function calculateDaysDiff(from: Date, to: Date): number {
    const fromDate = new Date(from.getFullYear(), from.getMonth(), from.getDate());
    const toDate = new Date(to.getFullYear(), to.getMonth(), to.getDate());
    const diff = Math.floor((toDate.getTime() - fromDate.getTime()) / (1000 * 60 * 60 * 24));
    return Math.max(0, diff);
}

// 获取最新文章日期
const lastPostDate = posts.reduce((latestDate, post) => {
    const postLatestDate = post.data.updated || post.data.published;
    if (!latestDate || postLatestDate > latestDate) {
        return postLatestDate;
    }
    return latestDate;
}, null as Date | null);

// 初始值（SSR渲染用，客户端会重新计算）
const today = new Date();
const diffDays = Math.ceil(calculateDaysDiff(new Date(siteStartDate), today));
const daysSinceLastUpdate = lastPostDate ? calculateDaysDiff(lastPostDate, today) : 0;
const lastPostDateIso = lastPostDate?.toISOString() ?? "";

// 统计数据
const stats = [
    {
        icon: "material-symbols:article-outline",
        label: i18n(I18nKey.siteStatsPostCount),
        value: posts.length,
    },
    {
        icon: "material-symbols:folder-outline",
        label: i18n(I18nKey.siteStatsCategoryCount),
        value: categories.length,
    },
    {
        icon: "material-symbols:label-outline",
        label: i18n(I18nKey.siteStatsTagCount),
        value: tags.length,
    },
    {
        icon: "material-symbols:text-ad-outline-rounded",
        label: i18n(I18nKey.siteStatsTotalWords),
        value: totalWords,
        formatted: true,
    },
    {
        icon: "material-symbols:calendar-clock-outline",
        label: i18n(I18nKey.siteStatsRunningDays),
        value: diffDays,
        suffix: i18n(I18nKey.siteStatsDays)?.replace("{days}", "") || "",
        dynamic: true,
        id: "running-days",
    },
    {
        icon: "material-symbols:ecg-heart-outline",
        label: i18n(I18nKey.siteStatsLastUpdate),
        value: daysSinceLastUpdate,
        suffix: i18n(I18nKey.siteStatsDaysAgo)?.replace("{days}", "") || "",
        dynamic: true,
        id: "last-update",
    },
];
---

<WidgetLayout
    name={i18n(I18nKey.siteStats)}
    id="site-stats"
    class={className}
    style={style}
    data-site-start-date={siteStartDate}
    data-last-post-date={lastPostDate?.toISOString()}
>
    <div class="flex flex-col gap-1">
        {
            stats.map((stat) => (
                <div class="flex items-center justify-between px-2 py-2">
                    <div class="flex items-center gap-2.5 flex-1 min-w-0">
                        <div class="text-(--primary) text-xl shrink-0">
                            <Icon name={stat.icon} />
                        </div>
                        <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm wrap-break-word leading-tight">
                            {stat.label}
                        </span>
                    </div>
                    <div class="flex items-center ml-3 shrink-0">
                        <span
                            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
                            data-stat-id={stat.id}
                        >
                            {stat.formatted
                                ? formatNumber(stat.value)
                                : stat.value}
                        </span>
                        {stat.suffix && (
                            <span class="text-sm text-neutral-500 dark:text-neutral-400 ml-1">
                                {stat.suffix}
                            </span>
                        )}
                    </div>
                </div>
            ))
        }
    </div>
</WidgetLayout>

<script is:inline define:vars={{ siteStartDate, lastPostDateIso }}>
    (function () {
        // 计算天数差
        function calculateDaysDiff(from, to) {
            const fromDate = new Date(from.getFullYear(), from.getMonth(), from.getDate());
            const toDate = new Date(to.getFullYear(), to.getMonth(), to.getDate());
            const diff = Math.floor((toDate.getTime() - fromDate.getTime()) / (1000 * 60 * 60 * 24));
            return Math.max(0, diff);
        }

        // 更新动态统计数据
        function updateSiteStats() {
            const today = new Date();
            const statsWidgets = document.querySelectorAll('#site-stats');
            if (!statsWidgets.length) return;

            statsWidgets.forEach((statsWidget) => {
                const siteStartDateAttr = statsWidget.getAttribute("data-site-start-date") || siteStartDate;
                const lastPostDateStr = statsWidget.getAttribute("data-last-post-date") || lastPostDateIso;

                // 更新网站运行天数
                if (siteStartDateAttr) {
                    const startDate = new Date(siteStartDateAttr);
                    if (!Number.isNaN(startDate.getTime())) {
                        const runningDays = Math.ceil(calculateDaysDiff(startDate, today));
                        const runningDaysElement = statsWidget.querySelector('[data-stat-id="running-days"]');
                        if (runningDaysElement) {
                            runningDaysElement.textContent = runningDays.toString();
                        }
                    }
                }

                // 更新最后更新天数
                if (lastPostDateStr) {
                    const lastPostDate = new Date(lastPostDateStr);
                    if (!Number.isNaN(lastPostDate.getTime())) {
                        const daysSinceLastUpdate = calculateDaysDiff(lastPostDate, today);
                        const lastUpdateElement = statsWidget.querySelector('[data-stat-id="last-update"]');
                        if (lastUpdateElement) {
                            lastUpdateElement.textContent = daysSinceLastUpdate.toString();
                        }
                    }
                }
            });
        }

        // 初始化：页面加载时执行
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", updateSiteStats);
        } else {
            updateSiteStats();
        }

        // 支持 Astro 页面导航（View Transitions）
        document.addEventListener("astro:page-load", updateSiteStats);
    })();
</script>

